PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/crm_assistant?schema=public"

# Supabase Auth
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# JWT Configuration (min 32 chars random secret)
JWT_SECRET=<random-secret-minimum-32-characters-long>

# CORS — Frontend URL
FRONTEND_URL=http://localhost:3000

# GitHub Actions deployment secrets (configure in repository/environment secrets, not local .env)
# DATABASE_URL is reused for production and staging migrations in this personal project.
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-...
# RENDER_DEPLOY_HOOK_URL_STAGING=https://api.render.com/deploy/srv-...
