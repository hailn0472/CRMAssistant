generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActivityType {
  EMAIL_SENT
  CALL_MADE
  MEETING_SCHEDULED
  NOTE_ADDED
  DEAL_CREATED
  CONTACT_CREATED
  CONTACT_UPDATED
  CONTACT_OWNER_CHANGED
}

// =============================================================================
// MULTI-TENANCY FOUNDATION MODELS
// =============================================================================
// Architecture note: Tenant is NOT itself tenant-scoped.
// All other domain models MUST include tenantId and follow the User pattern:
//   - tenantId String
//   - relation to Tenant
//   - @@index([tenantId])
//   - audit fields: createdAt, updatedAt, createdBy, updatedBy
//   - optional deletedAt DateTime? (soft delete)
//   - tenant-scoped unique constraints, e.g. @@unique([tenantId, email])
// Services MUST always filter by tenantId in all tenant-scoped queries.
// =============================================================================

enum DataVisibility {
  OWN
  TEAM
  ALL
}

enum AccessLevel {
  READ
  EDIT
  FULL
}

enum ResourceType {
  CONTACT
  DEAL
  TASK
}

// Task status/priority are closed, standard, cross-story vocabularies (4.4
// filters on them, 4.5 aggregates on them, 4.6 blocks completion on them), so
// they are Prisma enums — the schema's own precedent for closed vocabularies.
// The const tuples in apps/api/src/tasks/task-due-status.ts mirror these and
// remain the single source of truth for the Pothos enums, the service
// validators and the frontend Zod schema (Story 4.1 arbitration #3).
enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Tenant {
  id         String   @id @default(uuid())
  name       String
  enforce2FA Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users                    User[]
  contacts                 Contact[]
  tags                     Tag[]
  savedSegments            SavedSegment[]
  roles                    Role[]
  auditLogs                AuditLog[]
  apiKeys                  ApiKey[]
  teams                    Team[]
  sharingRules             SharingRule[]
  conversations            Conversation[]
  channelConnections       ChannelConnection[]
  contactChannelIdentities ContactChannelIdentity[]
  activities               Activity[]
  deals                    Deal[]
  dealStages               DealStage[]
  forecastSnapshots        ForecastSnapshot[]
  products                 Product[]
  dealLineItems            DealLineItem[]
  competitors              Competitor[]
  dealCompetitors          DealCompetitor[]
  dealDocuments            DealDocument[]
  dealComments             DealComment[]
  dealCommentMentions      DealCommentMention[]
  dealReminders            DealReminder[]
  dealReminderSnoozes      DealReminderSnooze[]
  userReminderPreferences  UserReminderPreference[]
  tasks                    Task[]
  taskTemplates            TaskTemplate[]
}

/// Tenant-scoped user model with authentication support.
/// Follows multi-tenancy pattern from Story 1.6.
/// Extended in Story 1.7 to support Supabase Auth integration.
/// Extended in Story 2.1: name → firstName + lastName, added profile fields, deactivation, lastLoginAt.
/// Extended in Story 2.2: removed `role` column — roles now managed via UserRole junction table.
/// Extended in Story 2.4: added teamId + team relation for team-based data visibility.
/// Extended in Story 2.6: added 2FA fields (twoFactorEnabled, twoFactorSecret, twoFactorBackupCodes),
/// SSO fields (ssoProvider, ssoId), and @@unique([tenantId, ssoProvider, ssoId]).
model User {
  id                   String    @id @default(uuid())
  tenantId             String
  email                String
  firstName            String    @default("")
  lastName             String
  avatar               String?
  phone                String?
  jobTitle             String?
  department           String?
  isActive             Boolean   @default(true)
  supabaseUserId       String?   @unique // Link to Supabase Auth user — null until first login
  teamId               String? // FK to Team — null means not assigned to any team
  lastLoginAt          DateTime?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes Json? // string[] — bcrypt-hashed backup codes
  ssoProvider          String? // 'GOOGLE' | 'AZURE_AD'
  ssoId                String? // Provider-specific user ID
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String    @default("system")
  updatedBy            String    @default("system")
  deletedAt            DateTime? // soft delete — null means active

  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team                  Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  managedTeam           Team[]               @relation("TeamManager")
  userRoles             UserRole[]
  auditLogs             AuditLog[]
  apiKeys               ApiKey[]
  ownedContacts         Contact[]            @relation("ContactOwner")
  assignedConversations Conversation[]       @relation("ConversationAssignee")
  sharedWithRules       SharingRule[]        @relation("SharedWithUser")
  MessageReadReceipt    MessageReadReceipt[]
  deals                 Deal[]               @relation("DealOwner")
  uploadedDealDocuments DealDocument[]       @relation("DealDocumentUploader")
  dealComments          DealComment[]        @relation("DealCommentAuthor")
  dealCommentMentions   DealCommentMention[] @relation("DealCommentMentionedUser")
  dealReminders         DealReminder[]       @relation("DealReminderRecipient")
  dealReminderSnoozes   DealReminderSnooze[] @relation("DealReminderSnoozeUser")
  reminderPreference    UserReminderPreference? @relation("UserReminderPreference")
  assignedTasks         Task[]                   @relation("TaskAssignee")

  // Email is unique per tenant, NOT globally unique
  @@unique([tenantId, email])
  // SSO link is unique per tenant + provider (Prisma 5+ supports nullable fields in composite unique)
  @@unique([tenantId, ssoProvider, ssoId])
  // Index for all tenant-scoped queries
  @@index([tenantId])
  // Index for active-user queries
  @@index([tenantId, isActive])
  // Index for fast Supabase user lookups
  @@index([supabaseUserId])
}

/// Tenant-scoped role model for RBAC (Story 2.2).
/// System roles (isSystem = true) cannot be deleted or renamed.
/// Designed to be extended with a permissions relation in Story 2.3.
/// Extended in Story 2.4: added dataVisibility field.
model Role {
  id             String         @id @default(uuid())
  tenantId       String
  name           String
  description    String?
  isSystem       Boolean        @default(false)
  dataVisibility DataVisibility @default(OWN)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      String         @default("system")
  updatedBy      String         @default("system")
  deletedAt      DateTime?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Tenant-scoped team model for team-based data visibility (Story 2.4).
model Team {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  managerId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String    @default("system")
  updatedBy String    @default("system")
  deletedAt DateTime?

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager         User?         @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members         User[] // users with this teamId
  sharedWithRules SharingRule[] @relation("SharedWithTeam")
  contacts        Contact[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Junction table linking users to roles (many-to-many).
/// Replaces the old `UserRole` enum and `User.role` column.
model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String   @default("system")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

/// Append-only audit log for tracking role assignments and other admin actions (Story 2.2).
/// Extended in Story 2.7: added ipAddress, userAgent fields.
/// No updates, no deletes. Indexed for efficient listing and lookup.
model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  action    String
  entity    String
  entityId  String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  Tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@index([userId])
}

/// API key model for third-party integrations (Story 2.7).
/// Key is bcrypt-hashed before storage — raw key is returned only at creation.
model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  keyPrefix   String
  keyHash     String
  userId      String
  permissions Json?
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  isRevoked   Boolean   @default(false)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([keyHash])
}

/// Global permission catalog (Story 2.3).
/// NOT tenant-scoped — shared across all tenants.
/// Defines all possible resource-action combinations.
model Permission {
  id          String   @id @default(uuid())
  resource    String
  action      String
  description String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

/// Junction table linking roles to permissions (many-to-many).
/// Role is tenant-scoped; Permission is global.
model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// Tenant-scoped contact model for CRM contact management.
/// Extended in Story 2.4: added ownerId + owner relation for data visibility.
model Contact {
  id        String    @id @default(uuid())
  tenantId  String
  email     String
  firstName String
  lastName  String
  phone     String?
  company   String?
  jobTitle  String?
  ownerId   String    @default("system")
  teamId    String?
  // Enrichment fields — optional data collected to build a 360° contact profile
  linkedin      String?
  twitter       String?
  addressStreet String?
  addressCity   String?
  addressCountry String?
  department    String?
  timezone      String?
  language      String?
  source        String?    // How the contact was acquired: Website, Referral, Event, etc.
  notes         String?    // Internal notes about the contact
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String    @default("system")
  updatedBy String    @default("system")
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  User   @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  tags              ContactTag[]
  conversations     Conversation[]
  channelIdentities ContactChannelIdentity[]
  activities        Activity[]
  deals             Deal[]
  tasks             Task[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, ownerId])
  @@index([tenantId, teamId])
  @@index([tenantId, createdAt])
}

/// Immutable activity log for contact timeline (Story 5.4).
/// Append-only — no updates, no deletes, no soft delete.
model Activity {
  id          String       @id @default(uuid())
  tenantId    String
  contactId   String
  type        ActivityType
  title       String
  description String?
  createdAt   DateTime     @default(now())
  createdBy   String       @default("system")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, contactId])
  @@index([tenantId, contactId, createdAt(sort: Desc)])
  @@index([tenantId, createdBy])
}

/// Tenant-scoped tag model for contact tagging and segmentation.
model Tag {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  color     String   @default("#3B82F6")
  createdAt DateTime @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts ContactTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Junction table for many-to-many relationship between contacts and tags.
model ContactTag {
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

/// Saved dynamic segments for reusable contact filtering.
model SavedSegment {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  filters   Json
  createdBy String    @default("system")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Sharing rules for cross-team collaboration (Story 2.5).
/// Exactly one of sharedWithUserId or sharedWithTeamId must be set (enforced at application layer).
model SharingRule {
  id               String       @id @default(uuid())
  tenantId         String
  resourceType     ResourceType
  resourceId       String // UUID of the shared record
  sharedWithUserId String? // null if shared with team
  sharedWithTeamId String? // null if shared with user
  accessLevel      AccessLevel
  sharedBy         String // userId who created the share
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sharedWithUser User?  @relation("SharedWithUser", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  sharedWithTeam Team?  @relation("SharedWithTeam", fields: [sharedWithTeamId], references: [id], onDelete: SetNull)

  @@unique([tenantId, resourceType, resourceId, sharedWithUserId])
  @@unique([tenantId, resourceType, resourceId, sharedWithTeamId])
  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, sharedWithUserId])
  @@index([tenantId, sharedWithTeamId])
  @@index([tenantId, resourceType, sharedWithUserId])
}

// =============================================================================
// OMNICHANNEL COMMUNICATION MODELS (Story 8A.1)
// =============================================================================

enum Channel {
  INTERNAL
  LIVE_CHAT
  FACEBOOK
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  ARCHIVED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  LOCATION
  TEMPLATE
  INTERNAL_NOTE
}

enum SenderType {
  AGENT
  CONTACT
  SYSTEM
}

model Conversation {
  id            String             @id @default(uuid())
  tenantId      String
  contactId     String?
  title         String?
  channel       Channel            @default(INTERNAL)
  status        ConversationStatus @default(OPEN)
  assignedTo    String?
  lastMessageAt DateTime?
  // Per-conversation watermark for the pull-based Facebook history sync
  // (Story 8A.4). Null = never synced. Only messages with created_time >
  // lastSyncedAt are persisted on subsequent passes. Per-conversation (rather
  // than per-connection) so one failing thread never advances past — and thus
  // permanently skips — another thread's unsynced messages.
  lastSyncedAt  DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  createdBy     String             @default("system")
  updatedBy     String             @default("system")
  deletedAt     DateTime?

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact        Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedToUser User?     @relation("ConversationAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  messages       Message[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, channel])
  @@index([tenantId, assignedTo])
  @@index([tenantId, contactId])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String
  senderType     SenderType
  content        String
  messageType    MessageType @default(TEXT)
  internalNote   Boolean     @default(false)
  metadata       Json?
  sentAt         DateTime    @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime    @default(now())
  createdBy      String      @default("system")

  conversation Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  receipts     MessageReadReceipt[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

// =============================================================================
// DEAL MODELS (Story 3.1)
// =============================================================================

/// Tenant-scoped pipeline stage model for customizable sales pipeline.
/// Stages are ordered and can be customized by ADMIN users.
model DealStage {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  order       Int       @default(0)
  probability Int       @default(0)
  isWon       Boolean   @default(false)
  isLost      Boolean   @default(false)
  color       String    @default("#3B82F6")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String    @default("system")
  updatedBy   String    @default("system")
  deletedAt   DateTime?

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals  Deal[]

  @@index([tenantId])
  @@index([tenantId, order])
  @@unique([tenantId, name])
}

/// Tenant-scoped deal model for tracking opportunities through the sales pipeline.
/// Links to a Contact (not Account — Account entity is deferred indefinitely).
/// No activity logging — Activity.contactId is required and no dealId column exists.
model Deal {
  id                String    @id @default(uuid())
  tenantId          String
  title             String
  value             Float     @default(0)
  currency          String    @default("USD")
  probability       Int       @default(0)
  stageId           String
  contactId         String
  ownerId           String
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String    @default("system")
  updatedBy         String    @default("system")
  deletedAt         DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stage   DealStage @relation(fields: [stageId], references: [id])
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  owner   User    @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  lineItems          DealLineItem[]
  competitors        DealCompetitor[]
  documents          DealDocument[]
  comments           DealComment[]
  reminders          DealReminder[]
  reminderSnoozes    DealReminderSnooze[]
  tasks              Task[]
  competitor         Competitor? @relation("DealWinLossCompetitor", fields: [competitorId], references: [id], onDelete: Restrict)
  winLossReason      String?
  winLossNote        String?
  competitorId       String?

  @@index([tenantId])
  @@index([tenantId, stageId])
  @@index([tenantId, contactId])
  @@index([tenantId, ownerId])
  @@index([tenantId, expectedCloseDate])
  @@index([tenantId, winLossReason])
}

/// Tenant-scoped product model for tracking sellable items.
model Product {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  description String?
  price       Float     @default(0)
  currency    String    @default("USD")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String    @default("system")
  updatedBy   String    @default("system")
  deletedAt   DateTime?

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lineItems DealLineItem[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

/// Tenant-scoped line item model linking products to deals.
/// unitPrice is a snapshot from Product.price at the time of addition.
/// total is computed server-side only: round2(quantity * unitPrice * (1 - discount / 100)).
/// onDelete: Restrict on productId — prevents accidental hard DELETE of referenced products.
model DealLineItem {
  id        String    @id @default(uuid())
  tenantId  String
  dealId    String
  productId String
  quantity  Float     @default(1)
  unitPrice Float
  discount  Float     @default(0)
  total     Float     @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String    @default("system")
  updatedBy String    @default("system")
  deletedAt DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, dealId])
  @@index([dealId, deletedAt])
  @@index([tenantId, productId])
}

/// Tenant-scoped competitor model for tracking rivals in win/loss analysis.
/// No DB unique constraint on name — duplicates are rejected in the service
/// over active rows only, so a soft-deleted competitor's name can be reused.
model Competitor {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  website    String?
  strengths  String?
  weaknesses String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String    @default("system")
  updatedBy  String    @default("system")
  deletedAt  DateTime?

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wonLostDeals Deal[]           @relation("DealWinLossCompetitor")
  dealLinks    DealCompetitor[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

/// Tenant-scoped junction model linking competitors to deals.
/// No DB unique on [dealId, competitorId] — duplicates are rejected in the
/// service over active rows only, so a removed-and-re-added link is allowed.
/// onDelete: Restrict on competitorId — prevents accidental hard DELETE of
/// referenced competitors.
model DealCompetitor {
  id           String   @id @default(uuid())
  tenantId     String
  dealId       String
  competitorId String
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String   @default("system")
  updatedBy    String   @default("system")
  deletedAt    DateTime?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal       Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, dealId])
  @@index([dealId, deletedAt])
  @@index([tenantId, competitorId])
}

/// Tenant-scoped document attachment for a deal (Story 3.6).
/// Files live in Supabase Storage at deals/{tenantId}/{dealId}/{documentId}-{sanitizedFileName};
/// the row stores the object path, never a URL (signed URLs expire, so a persisted
/// fileUrl would be wrong five minutes after it was written).
/// onDelete: Restrict on uploadedBy — an uploader must not be hard-deletable out
/// from under an attributed document.
model DealDocument {
  id          String   @id @default(uuid())
  tenantId    String
  dealId      String
  fileName    String
  storagePath String
  fileSize    Int
  mimeType    String
  uploadedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String   @default("system")
  updatedBy   String   @default("system")
  deletedAt   DateTime?

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  uploader User   @relation("DealDocumentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, dealId])
  @@index([dealId, deletedAt])
}

/// Tenant-scoped comment on a deal (Story 3.6).
/// Comment text is stored verbatim and never rendered as HTML on the client.
/// onDelete: Restrict on userId — an author must not be hard-deletable out from
/// under an attributed comment.
model DealComment {
  id        String   @id @default(uuid())
  tenantId  String
  dealId    String
  userId    String
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @default("system")
  updatedBy String   @default("system")
  deletedAt DateTime?

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal     Deal                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  author   User                @relation("DealCommentAuthor", fields: [userId], references: [id], onDelete: Restrict)
  mentions DealCommentMention[]

  @@index([tenantId])
  @@index([tenantId, dealId])
  @@index([dealId, deletedAt, createdAt])
}

/// Junction row recording that a DealComment mentions a tenant user (Story 3.6).
/// Story 4-8 (Notification Center) reads this table to turn mentions into bells;
/// this story only persists the row. Explicit junction, not a String[] scalar
/// list — there is not one array column in the schema today.
model DealCommentMention {
  id              String   @id @default(uuid())
  tenantId        String
  commentId       String
  mentionedUserId String
  createdAt       DateTime @default(now())

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comment       DealComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User       @relation("DealCommentMentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([commentId])
  @@index([tenantId, mentionedUserId])
}

/// Tenant-scoped reminder row produced by the daily deal-health sweep (Story 3.7).
/// The sweep persists the delivery *intent* and stops — no email transport
/// exists in this codebase. `deliveredAt` stays null until Story 4-8 (the
/// Notification Center) stamps delivery without a migration.
/// The @@unique([tenantId, dealId, reason, sweepDate]) constraint is the
/// idempotency key: running the sweep five times in one UTC day produces
/// exactly one row per (deal, reason) — what makes a lazily-triggered sweep
/// safe. `reason` and `healthStatus` are String, not Prisma enums —
/// Deal.winLossReason set the precedent of validating a fixed vocabulary in
/// the service rather than in the DB.
model DealReminder {
  id           String    @id @default(uuid())
  tenantId     String
  dealId       String
  userId       String // the recipient — the deal owner at sweep time
  reason       String // NO_ACTIVITY_7D | CLOSING_SOON_3D | AT_RISK
  healthStatus String // HEALTHY | AT_RISK | STALE
  healthScore  Int
  sweepDate    DateTime // UTC midnight of the day the sweep ran
  deliveredAt  DateTime? // always null in this story; Story 4-8 stamps it
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String    @default("system")
  updatedBy    String    @default("system")
  deletedAt    DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal      Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  recipient User   @relation("DealReminderRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dealId, reason, sweepDate])
  @@index([tenantId])
  @@index([tenantId, userId, sweepDate])
  @@index([tenantId, dealId])
}

/// Per-user snooze of deal health reminders (Story 3.7).
/// A separate table, never a column on Deal — Deal.updatedAt is @updatedAt,
/// so writing a snooze onto the deal row would bump updatedAt, which AC 20
/// uses as an activity signal: snoozing a stale deal would silently reset its
/// staleness clock and make it look healthy. Snooze is per user, not per deal.
model DealReminderSnooze {
  id           String    @id @default(uuid())
  tenantId     String
  dealId       String
  userId       String
  snoozedUntil DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String    @default("system")
  updatedBy    String    @default("system")
  deletedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user   User   @relation("DealReminderSnoozeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dealId, userId])
  @@index([tenantId])
  @@index([tenantId, userId])
}

/// Per-user reminder delivery preferences (Story 3.7).
/// emailFrequency is a String validated in the service against the
/// EMAIL_FREQUENCIES tuple (DAILY | WEEKLY | OFF). A user with no row is
/// treated as all-defaults (DAILY, all toggles true) — reads must not create
/// rows as a side effect.
model UserReminderPreference {
  id                 String   @id @default(uuid())
  tenantId           String
  userId             String   @unique // 1:1 with User — user IDs are globally unique UUIDs
  emailFrequency     String   @default("DAILY")
  notifyNoActivity   Boolean  @default(true)
  notifyClosingSoon  Boolean  @default(true)
  notifyAtRisk       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String   @default("system")
  updatedBy          String   @default("system")
  deletedAt          DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("UserReminderPreference", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
}

/// Point-in-time snapshot of the tenant-wide weighted forecast for one period.
/// Written through on every salesForecast query (no cron in this codebase).
/// Enables forecast-vs-actual accuracy, which cannot be reconstructed after the
/// fact because closing a deal overwrites Deal.probability with 100/0.
model ForecastSnapshot {
  id            String    @id @default(uuid())
  tenantId      String
  periodStart   DateTime
  periodEnd     DateTime
  snapshotDate  DateTime  // normalized to UTC midnight — one row per tenant/period/day
  forecastValue Float     @default(0)
  commitValue   Float     @default(0)
  bestCaseValue Float     @default(0)
  pipelineValue Float     @default(0)
  dealCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String    @default("system")
  updatedBy     String    @default("system")
  deletedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart, snapshotDate])
  @@index([tenantId])
  @@index([tenantId, periodStart])
}

model MessageReadReceipt {
  id          String    @id @default(uuid())
  messageId   String
  userId      String
  readAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

// =============================================================================
// OMNICHANNEL THIRD-PARTY CHANNEL MODELS (Story 8A.3)
// =============================================================================

/// Tenant-scoped per-tenant channel page/account connection (Facebook page now,
/// reusable for other 8B channels later). Access tokens are stored encrypted at
/// rest — never in plaintext (see common/crypto/token-crypto.ts).
model ChannelConnection {
  id                   String    @id @default(uuid())
  tenantId             String
  channel              Channel
  externalId           String // Facebook pageId (or equivalent external account id)
  accessTokenEncrypted String
  displayName          String?
  status               String    @default("ACTIVE") // ACTIVE | DISCONNECTED
  // Watermark for the pull-based history sync (Story 8A.4). Null = never
  // synced (first pass pulls everything the Graph API returns). Only messages
  // with created_time > lastSyncedAt are persisted on subsequent passes.
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String    @default("system")
  updatedBy            String    @default("system")
  deletedAt            DateTime?

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactIdentities ContactChannelIdentity[]

  @@unique([tenantId, channel, externalId])
  @@index([tenantId])
  @@index([tenantId, channel])
}

/// Maps an external channel identity (e.g. Facebook PSID) to a Contact, so we
/// don't have to abuse the required Contact.email for channel-only contacts.
model ContactChannelIdentity {
  id                  String   @id @default(uuid())
  tenantId            String
  contactId           String
  channel             Channel
  externalId          String // Facebook page-scoped user id (PSID)
  // Which ChannelConnection (page) this identity was first seen on — a PSID is
  // scoped to a single Facebook page, so this lets outbound dispatch pick the
  // correct page/token when a tenant has more than one connected (review fix,
  // Story 8A.3). Nullable so identities created before this field existed
  // still work (dispatch falls back to the tenant's oldest active connection).
  channelConnectionId String?
  createdAt           DateTime @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact           Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channelConnection ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, channel, externalId])
  @@index([tenantId])
  @@index([contactId])
  @@index([channelConnectionId])
}

// =============================================================================
// TASK MODELS (Story 4.1)
// =============================================================================

/// Tenant-scoped task model (Story 4.1).
/// assignedTo is NOT nullable — a nullable assignee combined with
/// resolveVisibilityFilter on assignedTo would make unassigned tasks invisible
/// to every non-ADMIN user. createdBy stays a plain String with no FK to User,
/// matching every other model in the schema — assignedTo is then the ONLY FK
/// from Task to User, so no ambiguous-relation error and no second back-relation
/// array on User (do not "improve" createdBy into a relation).
model Task {
  id          String       @id @default(uuid())
  tenantId    String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  assignedTo  String
  contactId   String?
  dealId      String?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String       @default("system")
  updatedBy   String       @default("system")
  deletedAt   DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee User     @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal     Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, assignedTo])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, contactId])
  @@index([tenantId, dealId])
}

/// Tenant-global task template catalogue (Story 4.1).
/// name is the picker label (e.g. "Discovery call follow-up"), title is the
/// title stamped onto the created task. No @@unique([tenantId, name]) — soft
/// delete + unique is a documented trap (DealStage); uniqueness is enforced
/// case-insensitively in TaskTemplatesService over deletedAt: null rows.
model TaskTemplate {
  id               String       @id @default(uuid())
  tenantId         String
  name             String
  title            String
  description      String?
  defaultPriority  TaskPriority @default(MEDIUM)
  defaultDueInDays Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  updatedBy        String       @default("system")
  createdBy        String       @default("system")
  deletedAt        DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
