# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000

# JWT verification for middleware (must match backend JWT_SECRET)
JWT_SECRET=<random-secret-minimum-32-characters-long>

# Supabase (sẽ được dùng từ Story 1.7)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
