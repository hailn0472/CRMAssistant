# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000

# JWT verification for protected route middleware.
# Must match apps/api JWT_SECRET because the API signs the auth-token cookie value.
JWT_SECRET=<same-random-secret-as-api-jwt-secret>

# Supabase (sẽ được dùng từ Story 1.7)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# GitHub Actions staging deployment secrets (configure in repository/environment secrets, not local .env)
# NEXT_PUBLIC_API_URL_STAGING=https://crm-assistant-api-staging.example.com
# NEXT_PUBLIC_SUPABASE_URL_STAGING=https://your-staging-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY_STAGING=your_staging_supabase_anon_key
# VERCEL_PROJECT_ID_STAGING=your_staging_vercel_project_id
